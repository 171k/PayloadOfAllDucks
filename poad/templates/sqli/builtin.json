      "name": "sqli-union-string-orderby2",
      "category": "sqli",
      "engine": "generic",
      "mode": "union",
      "context": "string",
      "template": "' ORDER BY 2-- -",
      "required": [],
      "tags": [
        "union"
      ],
      "notes": "Column-count probe: errors when fewer than 2 columns."
    },
